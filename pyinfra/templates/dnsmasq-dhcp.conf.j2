# DHCP is intentionally left unconfigured until the service-network schema is
# agreed. DHCP ranges and dhcp-authoritative must be scoped to an explicit
# service interface, never interface=* or the management interface.
# dnsmasq advertises its own address on that interface as DNS when option 6 is
# omitted.
# dhcp-range=SERVICE_INTERFACE,START_IP,END_IP,LEASE_TIME
# dhcp-option=SERVICE_INTERFACE,3,GATEWAY_IP
